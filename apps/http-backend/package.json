{
  "name": "http-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
  "build": "tsup src/index.ts --format esm --clean --no-external --external @prisma/client",
  "start": "node dist/index.js",
  "dev": "tsx watch src/index.ts",
  "lint": "tsc --noEmit"
},
  "dependencies": {
    "@repo/common": "workspace:*",
    "@repo/db": "workspace:*",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.10",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}