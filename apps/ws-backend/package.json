{
  "name": "ws-backend",
  "version": "1.0.0",
  "main": "src/index.ts",
 "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --outfile=dist/index.js --external:@prisma/client",
    "start": "NODE_PATH=../../node_modules node dist/index.js",
    "dev": "npm run build && npm run start"
  },
  "dependencies": {
    "@repo/common": "workspace:*",
    "@repo/db": "workspace:*",
    "dotenv": "^16.6.1",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.24",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.27.3",
    "typescript": "^5.3.3"
  }
}